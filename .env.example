# Public frontend config only — safe to expose in the browser.
# Default in code is the live Render twin if this is unset.

NEXT_PUBLIC_TWIN_API_URL=https://digital-twin-69dv.onrender.com

# Optional. Leave unset to auto-detect:
#   gradio  = live Render host (POST /gradio_api/call/respond)
#   fastapi = Project-Portfolio twin-api (POST /chat/stream)
# NEXT_PUBLIC_TWIN_API_MODE=gradio

# Server-only rewrite target for /twin-proxy/* (defaults to the public URL).
# TWIN_API_URL=https://digital-twin-69dv.onrender.com

# Do NOT put OPENAI_API_KEY or PUSHOVER_* in this frontend env.
# Those belong on the Render twin host only.
